; Configuration for jitsi-audio-bridge.
;
; Copy to config.ini and edit. The daemon looks for, in order:
;   1. --config PATH
;   2. $JITSI_AUDIO_BRIDGE_CONFIG
;   3. ./config.ini
;   4. /etc/jitsi-audio-bridge/config.ini
; with built-in defaults underneath all of them.
;
; Every value can also be set from the environment as
; JITSI_AUDIO_BRIDGE_<SECTION>_<KEY>, e.g. JITSI_AUDIO_BRIDGE_SMTP_PASSWORD.
; The environment wins over this file, which is the intended way to pass
; secrets: keep config.ini at mode 0644 and put the password in a root-owned
; EnvironmentFile instead.
;
; The SMTP password is the only value that is really a secret. config.ini is
; listed in .gitignore so that a copy holding one is never committed.

[server]
; Address the WebSocket server binds to. Keep it on loopback unless the JVB
; reaches this host over the network, and firewall it if it does.
host = 127.0.0.1
port = 8080

[storage]
; Per-meeting directories are created underneath this path, so the user the
; daemon runs as must be able to write here.
recordings_dir = /srv/recordings
; Delete the audio, transcript and summary once the email has been sent.
; Off by default: these files are the only copy of the meeting, so a
; misconfiguration should not be able to destroy one.
cleanup_after_send = false
; Where a Prosody module (docs/jitsi-integration.md §5) drops per-meeting
; metadata, keyed by meeting id.  Stock Jitsi's framing carries no names,
; addresses or room name; with this set, a session adopts the file written for
; it — room name, participants, and those speakers' names — as its metadata.
; Empty disables it and leaves such sessions on the defaults.
session_metadata_dir =
; Write timeline.json for sessions fed by the JVB's media export: who spoke
; when, on the session's own clock.  The timing can only be captured while the
; meeting is running, and it is what lets the transcript be interleaved.
capture_timeline = true
; How long a session may stay silent before the meeting counts as over.  A
; connection ending is not the meeting ending -- the JVB closes one export and
; opens another for the same conference -- so the transcript and the mail wait
; this long, and a connection arriving sooner cancels them.  Zero mails each
; connection's audio separately, which is what a meeting interrupted mid-way
; used to produce.
session_grace_seconds = 60

[transcript]
; Merge the participants' speaking turns into one time-ordered document,
; "[00:03:12] Alice: ...", instead of one block per participant.  Sessions
; with no timeline keep the per-participant shape either way.
interleave = true
; Silence between two turns of one speaker that still counts as one turn when
; they are transcribed.
merge_gap_seconds = 1.0

[ai]
; How many requests the daemon may have in flight against Whisper and Ollama
; together.  They usually share one machine, often one GPU, whose queue takes
; one request at a time -- asking for more is what makes one model evict
; another and the starved service answer 5xx.  1 matches a single GPU: the
; daemon then waits for each request to finish before sending the next.  Raise
; it when the two services are on separate machines.
max_concurrent_requests = 1
; How many times one request may be tried before it is given up on, waiting
; twice as long each time: 1s, 2s, 4s, 8s...  Five spans about fifteen seconds
; in all, which is the scale of a model being evicted from a shared GPU and
; loaded again.  1 disables retrying.
max_attempts = 5

[whisper]
; Endpoint accepting {"audio_base64": ..., "filename": ...} and returning
; {"text": ...}.
url = https://whisper.omnia.amarulasolutions.com/transcribe-b64
; Transcribing a long meeting can take minutes.
timeout = 600
; Set to false only for an endpoint with a self-signed certificate.
verify_tls = true

[ollama]
url = https://ollama.omnia.amarulasolutions.com/api/generate
model = qwen2.5:14b-instruct
timeout = 600
verify_tls = true

[smtp]
host = 127.0.0.1
port = 25
; Leave both blank for a relay that accepts mail without authentication.
user =
password =
sender = no-reply@amarulasolutions.com
; Used when the meeting's metadata carries no participant addresses.
fallback_recipient = admin@omnia.amarulasolutions.com
; Issue STARTTLS before authenticating. Leave true unless the relay is on
; loopback and does not offer it.
use_starttls = true
; Appended to the subject line. Either spelling works: "Amarula Solutions" or
; "- Amarula Solutions".
subject_suffix = Amarula Solutions
